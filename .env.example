# Environment Configuration
NODE_ENV=development
PORT=4000
WEB_PORT=3000
MOCK_ERP_PORT=5000

# PostgreSQL (Private tables with RLS)
DATABASE_URL="postgresql://verifolio_app:verifolio_secret@localhost:5432/verifolio?schema=public"
DATABASE_ADMIN_URL="postgresql://postgres:postgres@localhost:5432/verifolio?schema=public"

# Redis (BullMQ & Cache)
REDIS_URL="redis://localhost:6379"

# S3 / MinIO
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="verifolio-evidence"
S3_REGION="us-east-1"

# Auth & JWT
JWT_SECRET="super-secret-jwt-key-replace-in-prod"
JWT_REFRESH_SECRET="super-secret-refresh-key-replace-in-prod"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Suggester
AI_PROVIDER="rules" # "gemini" or "rules"
GEMINI_API_KEY=""

# Ed25519 Signing Keys
SEAL_KEY_ID="key-2026-1"
SEAL_PRIVATE_KEY=""
SEAL_PUBLIC_KEY=""

# ERP Sync & Webhooks
ERP_WEBHOOK_SECRET="erp-hmac-shared-secret"
MOCK_ERP_URL="http://localhost:5000"
